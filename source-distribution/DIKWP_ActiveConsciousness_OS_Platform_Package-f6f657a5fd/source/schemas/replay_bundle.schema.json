{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReplayBundle",
  "type": "object",
  "required": [
    "session_id",
    "packets",
    "decisions",
    "evidence",
    "outcomes"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "packets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}