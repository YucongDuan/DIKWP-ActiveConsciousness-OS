{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HumanContextPacket",
  "type": "object",
  "required": [
    "context_text",
    "explicit_purpose"
  ],
  "properties": {
    "context_text": {
      "type": "string"
    },
    "explicit_purpose": {
      "type": "string"
    },
    "emotional_tone": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "autonomy_level": {
      "type": "string",
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4",
        "A5"
      ]
    }
  }
}