{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/active_consciousness_session.schema.json",
  "title": "ActiveConsciousnessSession",
  "type": "object",
  "required": [
    "session_id",
    "user_id",
    "claim_level",
    "consent_scope"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "claim_level": {
      "type": "string",
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3"
      ]
    },
    "consent_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}